{
  "expo": {
    "name": "Orbit Mobile",
    "slug": "orbit-mobile",
    "scheme": "orbit-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.zhouyanbo.orbit.capture",
      "usesIcloudStorage": true,
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.zhouyanbo.orbit.capture"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.zhouyanbo.orbit.capture"
        ],
        "com.apple.security.application-groups": [
          "group.com.zhouyanbo.orbit.capture"
        ]
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Orbit Mobile needs microphone access to save voice captures locally.",
        "NSBluetoothAlwaysUsageDescription": "Orbit Mobile uses Bluetooth to connect to your Newman X1 recorder and import recordings locally.",
        "NSSpeechRecognitionUsageDescription": "Orbit Mobile can transcribe voice captures on device when available.",
        "NSCameraUsageDescription": "Orbit Mobile needs camera access to save photo captures locally.",
        "NSPhotoLibraryUsageDescription": "Orbit Mobile needs photo library access to save selected images locally."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "371314e9-4ff3-423b-b20c-ad3f38cb6959"
      }
    },
    "owner": "yanbob"
  }
}
